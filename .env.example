# Required to start the Telegram bot. Obtain it from @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user IDs. Leave empty when no administrators are configured.
ADMINS=
ADMIN_SECRET_CODE=
# Empty ADMIN_SECRET_CODE disables legacy /auth code authentication.
ADMIN_SESSION_HOURS=24

URL_SHORTENER_SERVICE=tinyurl
CUTTLY_API_KEY=

# Reserved until the disabled media-download UI is re-enabled deliberately.
MEDIA_DOWNLOADER_ENABLED=false
MAX_DOWNLOAD_SIZE_MB=50
MAX_DOWNLOADS_PER_USER_PER_DAY=10

IP_INFO_API_SERVICE=ipapi
IPINFO_API_KEY=
GROQ_API_KEY=
CHEAPSHARK_API_KEY=

LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO

BACKUP_ENABLED=true
BACKUP_TIME=03:00
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30

# Comma-separated Telegram user IDs.
BLOCKED_USERS=
