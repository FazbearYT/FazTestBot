# Installed as /etc/faztestbot/faztestbot.env with mode 0600.
# Do not place this populated file in Git, cloud-init metadata, or shell history.
BOT_TOKEN=
FAZTESTBOT_DATA_DIR=/var/lib/faztestbot

# Comma-separated Telegram user IDs.
ADMINS=
ADMIN_SECRET_CODE=
ADMIN_SESSION_HOURS=24

URL_SHORTENER_SERVICE=tinyurl
CUTTLY_API_KEY=
IP_INFO_API_SERVICE=ipapi
IPINFO_API_KEY=
GROQ_API_KEY=
CHEAPSHARK_API_KEY=

MEDIA_DOWNLOADER_ENABLED=false
MAX_DOWNLOAD_SIZE_MB=50
MAX_DOWNLOADS_PER_USER_PER_DAY=10

LOG_RETENTION_DAYS=30
LOG_LEVEL=INFO
BACKUP_ENABLED=true
BACKUP_TIME=03:00
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
BLOCKED_USERS=
